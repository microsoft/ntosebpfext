<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" TreatAsLocalProperty="Platform">
  <PropertyGroup>
    <HostPlatform>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)</HostPlatform>
    <!-- Visual Studio 2026 (MSBuild 18.0+) requires the newer WDK; Visual Studio 2022 (MSBuild 17)
         uses the prior WDK. Directory.Packages.props selects the matching package version.

         These gate on $(MSBuildAssemblyVersion) rather than $(VisualStudioVersion). $(VisualStudioVersion)
         is only populated when the build is launched from a Developer Command Prompt / VS and is empty
         when msbuild.exe is invoked directly, which silently selected the VS2022 WDK under MSBuild 18.
         That produced a mismatched pair (target platform 10.0.28000.0 with WDK 10.0.26100.4204) and
         failed with MSB4062 loading Microsoft.DriverKit.Build.Tasks.18.0.dll, an assembly the 26100
         package does not ship, plus MSB8036 for the missing 10.0.28000.0 SDK. $(MSBuildAssemblyVersion)
         is always defined and is the same value the WDK targets use to pick that task assembly.

         The fallbacks are explicitly conditioned on '&lt; 18.0' rather than left unconditional so an
         unexpected toolset version fails loudly instead of silently selecting the VS2022 WDK. -->
    <WindowsTargetPlatformVersion Condition="'$(WindowsTargetPlatformVersion)' == '' and '$(MSBuildAssemblyVersion)' &gt;= '18.0'">10.0.28000.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformVersion Condition="'$(WindowsTargetPlatformVersion)' == '' and '$(MSBuildAssemblyVersion)' &lt; '18.0'">10.0.26100.0</WindowsTargetPlatformVersion>
    <WDKVersion Condition="'$(WDKVersion)' == '' and '$(MSBuildAssemblyVersion)' &gt;= '18.0'">10.0.28000.1839</WDKVersion>
    <WDKVersion Condition="'$(WDKVersion)' == '' and '$(MSBuildAssemblyVersion)' &lt; '18.0'">10.0.26100.4204</WDKVersion>
    <!-- Default platform toolset for user-mode projects. Visual Studio 2026 (MSBuild 18) uses v145;
         Visual Studio 2022 (MSBuild 17) uses v143. Kernel-mode projects override this with
         WindowsKernelModeDriver10.0 in their own Configuration PropertyGroups. Keeping this in lockstep
         with the WDK/target-platform selection above ensures Catch2 (built by the matching CMake
         generator) and the user-mode projects share one toolset, avoiding STL link mismatches. -->
    <EbpfPlatformToolset Condition="'$(EbpfPlatformToolset)' == '' and '$(MSBuildAssemblyVersion)' &gt;= '18.0'">v145</EbpfPlatformToolset>
    <EbpfPlatformToolset Condition="'$(EbpfPlatformToolset)' == '' and '$(MSBuildAssemblyVersion)' &lt; '18.0'">v143</EbpfPlatformToolset>
    <!-- Platform toolset consumed by the ebpf-extension-common submodule. Its Directory.Build.props
         imports "$(SolutionDir)wdk.props", which resolves to THIS file when the submodule is built as
         part of ntosebpfext.sln, so the toolset variable its vcxproj files reference
         ($(EbpfExtPlatformToolset)) must be defined here. Kept in lockstep with $(EbpfPlatformToolset)
         so the submodule's user-mode lib and the consuming unit-test objects share one toolset
         (mismatched toolsets cause C1047 under Release LTCG). -->
    <EbpfExtPlatformToolset Condition="'$(EbpfExtPlatformToolset)' == '' and '$(MSBuildAssemblyVersion)' &gt;= '18.0'">v145</EbpfExtPlatformToolset>
    <EbpfExtPlatformToolset Condition="'$(EbpfExtPlatformToolset)' == '' and '$(MSBuildAssemblyVersion)' &lt; '18.0'">v143</EbpfExtPlatformToolset>

    <NuGetPackageRoot Condition="'$(NuGetPackageRoot)' == '' and '$(NUGET_PACKAGES)' != ''">$(NUGET_PACKAGES)\</NuGetPackageRoot>
    <NuGetPackageRoot Condition="'$(NuGetPackageRoot)' == ''">$(UserProfile)\.nuget\packages\</NuGetPackageRoot>
    <UsersimWindowsTargetPlatformVersion Condition="'$(UsersimWindowsTargetPlatformVersion)' == ''">$(WindowsTargetPlatformVersion)</UsersimWindowsTargetPlatformVersion>
    <UsersimWDKVersion Condition="'$(UsersimWDKVersion)' == ''">$(WDKVersion)</UsersimWDKVersion>
    <UsersimPlatformToolset Condition="'$(UsersimPlatformToolset)' == ''">$(EbpfPlatformToolset)</UsersimPlatformToolset>
    <_EbpfIsUsersimProject>$([System.String]::Copy('$(MSBuildProjectDirectory)').Contains('\external\usersim\'))</_EbpfIsUsersimProject>
    <_EbpfIsGeneratedKernelModeProject>$([System.String]::Copy('$(MSBuildProjectDirectory)').Contains('_km'))</_EbpfIsGeneratedKernelModeProject>
    <_EbpfUseSolutionWdkReferences Condition="'$(_EbpfIsUsersimProject)' != 'True' and '$(_EbpfIsGeneratedKernelModeProject)' != 'True'">true</_EbpfUseSolutionWdkReferences>
    <_EbpfTargetPackagePlatform Condition="'$(Platform)' != ''">$(Platform)</_EbpfTargetPackagePlatform>
    <_EbpfTargetPackagePlatform Condition="'$(_EbpfTargetPackagePlatform)' == ''">x64</_EbpfTargetPackagePlatform>
    <_EbpfTargetPackagePlatform>$(_EbpfTargetPackagePlatform.ToLowerInvariant())</_EbpfTargetPackagePlatform>
    <_EbpfTargetPackagePlatform Condition="'$(_EbpfTargetPackagePlatform)' == 'amd64'">x64</_EbpfTargetPackagePlatform>
    <_EbpfTargetPackagePlatform Condition="'$(_EbpfTargetPackagePlatform)' == 'win32'">x86</_EbpfTargetPackagePlatform>
    <TargetFramework Condition="'$(TargetFramework)' == ''">native</TargetFramework>
    <_NuGetTargetFallbackMoniker Condition="'$(_NuGetTargetFallbackMoniker)' == ''">native,Version=v0.0</_NuGetTargetFallbackMoniker>
    <RestorePackages Condition="'$(RestorePackages)' == ''">true</RestorePackages>
    <RestoreProjectStyle Condition="'$(RestoreProjectStyle)' == ''">PackageReference</RestoreProjectStyle>
    <MSBuildProjectExtensionsPath Condition="'$(MSBuildProjectExtensionsPath)' == ''">$(MSBuildProjectDirectory)\obj\$(MSBuildProjectName)\</MSBuildProjectExtensionsPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(_EbpfUseSolutionWdkReferences)' == 'true'">
    <PackageReference Include="Microsoft.Windows.SDK.CPP" PrivateAssets="all">
      <Version Condition="'$(ManagePackageVersionsCentrally)' != 'true'">$(WDKVersion)</Version>
    </PackageReference>
    <PackageReference Include="Microsoft.Windows.SDK.CPP.$(_EbpfTargetPackagePlatform)" PrivateAssets="all">
      <Version Condition="'$(ManagePackageVersionsCentrally)' != 'true'">$(WDKVersion)</Version>
    </PackageReference>
    <PackageReference Include="Microsoft.Windows.WDK.$(_EbpfTargetPackagePlatform)" PrivateAssets="all">
      <Version Condition="'$(ManagePackageVersionsCentrally)' != 'true'">$(WDKVersion)</Version>
    </PackageReference>
  </ItemGroup>

  <Target Name="EnsureWdkPackageBuildImports" BeforeTargets="PrepareForBuild" Condition="'$(_EbpfUseSolutionWdkReferences)' == 'true'">
    <PropertyGroup>
      <_EbpfNormalizedNuGetPackageRoot>$([MSBuild]::EnsureTrailingSlash('$(NuGetPackageRoot)'))</_EbpfNormalizedNuGetPackageRoot>
      <_EbpfExpectedWdkContentRoot>$([MSBuild]::EnsureTrailingSlash('$([MSBuild]::NormalizePath('$(_EbpfNormalizedNuGetPackageRoot)microsoft.windows.wdk.$(_EbpfTargetPackagePlatform)\$(NativeWdkVersion)\c'))'))</_EbpfExpectedWdkContentRoot>
      <_EbpfActualWdkContentRoot Condition="'$(WdkContentRoot)' != ''">$([MSBuild]::EnsureTrailingSlash('$([MSBuild]::NormalizePath('$(WdkContentRoot)'))'))</_EbpfActualWdkContentRoot>
      <_EbpfExpectedWdkInclude>$(WdkContentRoot)\Include\$(WindowsTargetPlatformVersion)\km</_EbpfExpectedWdkInclude>
      <_EbpfExpectedSdkInclude>$(WindowsSdkDir)\Include\$(WindowsTargetPlatformVersion)\shared</_EbpfExpectedSdkInclude>
      <_EbpfMissingPackageError>The required WDK/SDK package assets are missing or do not match the selected Visual Studio version. Restore the solution or run .\scripts\initialize_repo.ps1. The missing path is {0}.</_EbpfMissingPackageError>
    </PropertyGroup>
    <Error Condition="'$(_EbpfActualWdkContentRoot)' != '$(_EbpfExpectedWdkContentRoot)'"
           Text="$([System.String]::Format('$(_EbpfMissingPackageError)', '$(_EbpfExpectedWdkContentRoot)'))" />
    <Error Condition="'$(WdkContentRoot)' == '' or !Exists('$(_EbpfExpectedWdkInclude)')"
           Text="$([System.String]::Format('$(_EbpfMissingPackageError)', '$(_EbpfExpectedWdkInclude)'))" />
    <Error Condition="'$(WindowsSdkDir)' == '' or !Exists('$(_EbpfExpectedSdkInclude)' )"
           Text="$([System.String]::Format('$(_EbpfMissingPackageError)', '$(_EbpfExpectedSdkInclude)'))" />
  </Target>
</Project>